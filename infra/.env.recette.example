# Configuration Recette / Staging TSOTSA Kids
# Copier ce fichier vers /opt/tsotsa-kids/.env sur le serveur de recette et remplir les valeurs
APP_ENV=staging
APP_TIMEZONE_DEFAULT=Africa/Douala
API_BASE_URL=
WEB_APP_URL=
ADMIN_APP_URL=
CORS_ALLOWED_ORIGINS=

DATABASE_URL=
DATABASE_MIGRATIONS_URL=
DATABASE_SSL_CA_PATH=
DATABASE_POOL_SIZE=10

JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
BCRYPT_ROUNDS=12

GOOGLE_CLIENT_IDS=

OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_NAME=

EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

EXPO_ACCESS_TOKEN=""
NOTIFICATION_REMINDER_DELAY_MINUTES=30
NOTIFICATION_QUIET_HOURS=21:00-06:00

UPLOAD_MAX_MB=10
LOG_LEVEL=INFO
SENTRY_DSN=

# Pour les scripts d'administration / sauvegarde
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=tsotsa_recette
MYSQL_USER=tsotsa_migrator
MYSQL_PASSWORD=
MYSQL_SSL_CA=/opt/tsotsa-kids/secrets/ovh-mysql-ca.pem

