# Configuration Production TSOTSA Kids
# Copier ce fichier vers /opt/tsotsa-kids/.env sur le serveur de production
APP_ENV=production
APP_TIMEZONE_DEFAULT=Africa/Douala
API_BASE_URL=https://api.tsotsa-for-kids.com
WEB_APP_URL=https://app.tsotsa-for-kids.com
ADMIN_APP_URL=https://admin.tsotsa-for-kids.com
CORS_ALLOWED_ORIGINS=https://app.tsotsa-for-kids.com,https://admin.tsotsa-for-kids.com,http://localhost:3000

# Base de données MySQL locale intégrée (Docker)
DATABASE_URL=mysql+asyncmy://tsotsa_app:TsotsaApp2026Secret!@mysql:3306/tsotsa_prod
DATABASE_MIGRATIONS_URL=mysql+asyncmy://root:TsotsaProd2026RootSecret!@mysql:3306/tsotsa_prod
DATABASE_SSL_CA_PATH=
DATABASE_POOL_SIZE=10

MYSQL_ROOT_PASSWORD=TsotsaProd2026RootSecret!
MYSQL_DATABASE=tsotsa_prod
MYSQL_USER=tsotsa_app
MYSQL_PASSWORD=TsotsaApp2026Secret!
MYSQL_HOST=mysql
MYSQL_PORT=3306

JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
BCRYPT_ROUNDS=12

GOOGLE_CLIENT_IDS=

OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_NAME=TSOTSA

EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=TSOTSA for Kids <no-reply@tsotsa-for-kids.com>

EXPO_ACCESS_TOKEN=""
NOTIFICATION_REMINDER_DELAY_MINUTES=30
NOTIFICATION_QUIET_HOURS=21:00-06:00

UPLOAD_MAX_MB=10
LOG_LEVEL=INFO
SENTRY_DSN=
