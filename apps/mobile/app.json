{
  "expo": {
    "name": "TSOTSA for Kids",
    "slug": "tsotsa-kids",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "tsotsakids",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#EEF2F0"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tsotsaforkids.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EEF2F0"
      },
      "package": "com.tsotsaforkids.app"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "5eec1bc5-7346-4101-9c18-7f12c5a86866"
      }
    }
  }
}
