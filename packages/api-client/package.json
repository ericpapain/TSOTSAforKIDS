{
  "name": "@tsotsa/api-client",
  "version": "0.1.0",
  "description": "Client API TypeScript partagé TSOTSA Kids généré depuis OpenAPI",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./generated": {
      "types": "./src/generated/schema.d.ts"
    }
  },
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/generated/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.6.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}

